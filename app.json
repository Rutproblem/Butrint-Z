{
  "expo": {
    "name": "Biblioteka Online",
    "slug": "biblioteka-online",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#f4f3ec"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Lejo Biblioteka Online të zgjedhë një imazh për kopertinën e librit."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f4f3ec"
      }
    }
  }
}
